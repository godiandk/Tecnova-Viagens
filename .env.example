# ---------------------------------------------------------------------------
# Fonte das ofertas de voo
# ---------------------------------------------------------------------------
# simulado  -> dados de demonstração, sem rede e sem credencial (padrão)
# amadeus   -> Amadeus Enterprise, exige credenciais obtidas comercialmente
#
# Deixando em branco, o site usa a Amadeus se houver credenciais e cai para o
# simulado caso contrário.
PROVEDOR=simulado

# ---------------------------------------------------------------------------
# Amadeus — ATENÇÃO: o cadastro automático não existe mais
# ---------------------------------------------------------------------------
# O programa Self-Service, que era gratuito e de cadastro automático, foi
# desativado em 17 de julho. O que restou em developers.amadeus.com são as
# Enterprise APIs, liberadas mediante pedido comercial.
#
# O adaptador continua no código porque as Enterprise APIs usam os mesmos
# endpoints: quem conseguir acesso comercial preenche as chaves abaixo e o
# site funciona. Para quem não tem esse acesso, veja as alternativas no README.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# test (padrão) ou producao
AMADEUS_AMBIENTE=test
