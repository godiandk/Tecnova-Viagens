# ---------------------------------------------------------------------------
# Fonte das ofertas de voo
# ---------------------------------------------------------------------------
# simulado  -> dados de demonstração, sem rede e sem credencial (padrão)
# amadeus   -> Amadeus Self-Service, exige as credenciais abaixo
#
# Deixando em branco, o site usa a Amadeus se houver credenciais e cai para o
# simulado caso contrário.
PROVEDOR=simulado

# ---------------------------------------------------------------------------
# Amadeus Self-Service — https://developers.amadeus.com
# ---------------------------------------------------------------------------
# Crie uma conta gratuita, registre um app e copie as chaves.
# O ambiente "test" é gratuito, porém devolve inventário reduzido e preços
# defasados: serve para desenvolver, não para decidir uma compra.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# test (padrão) ou producao
AMADEUS_AMBIENTE=test
